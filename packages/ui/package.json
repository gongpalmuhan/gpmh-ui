{
  "name": "@gpmh/ui",
  "version": "0.1.0",
  "description": "Neutral React UI components for GPMH projects.",
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-package-assets.mjs ui",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
